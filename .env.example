# Public Binance market data only; API credentials are neither needed nor used.
HCL_EXCHANGE=binance
HCL_TIMEFRAME=1d
HCL_SINCE=2017-01-01T00:00:00Z
HCL_FETCH_LIMIT=1000
HCL_MAX_RETRIES=5
HCL_BACKOFF_BASE_SECONDS=1.0
HCL_REQUEST_TIMEOUT_MS=30000
HCL_ASSETS_CONFIG=config/assets.yaml
HCL_DATABASE_PATH=database/trading.duckdb
HCL_LOG_LEVEL=INFO
HCL_INITIAL_CASH=2000.0
HCL_FEE_RATE=0.001
HCL_SLIPPAGE_RATE=0.0005
HCL_PAPER_DRY_RUN=true
HCL_PAPER_DATABASE=database/paper_trading.duckdb
HCL_TELEGRAM_TARGET=
