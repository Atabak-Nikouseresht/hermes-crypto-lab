# Preserve byte-stable governance and manifest inputs across platforms.
# The active hardening manifest hashes file bytes, so checkout must not rewrite EOLs.
.gitattributes -text
.env.example -text
.gitignore -text
.github/workflows/*.yml -text
.python-version -text
README.md -text
SECURITY.md -text
CONTRIBUTING.md -text
docs/*.md -text
audits/*.md -text
data/*.md -text
config/*.yaml -text
requirements.lock -text
requirements.txt -text
pyproject.toml -text
run_*.py -text
scripts/*.py -text
scripts/*.ps1 -text
src/*.py -text
tests/test_ci_quality.py text eol=lf
tests/test_forward_operations.py text eol=lf
tests/test_forward_safety.py text eol=lf
tests/test_paper_config.py text eol=lf
tests/test_paper_market.py text eol=lf
tests/test_paper_trading.py text eol=lf
tests/test_runner_safety.py text eol=lf
tests/test_scheduler_contract.py text eol=lf
forward_experiment/**/*.json -text
forward_experiment/**/*.sha256 -text
forward_experiment/**/*.sql -text
experiments/runs/*/experiment_ledger.jsonl -text
