# Preserve byte-stable governance and manifest inputs across platforms.
# The active hardening manifest hashes file bytes, so checkout must not rewrite EOLs.
.gitattributes -text
.gitleaks.toml text eol=lf
.env.example -text
.gitignore -text
.github/workflows/*.yml -text
.python-version -text
README.md -text
SECURITY.md -text
CONTRIBUTING.md -text
docs/*.md -text
audits/*.md -text
data/*.md -text
config/*.yaml -text
requirements.lock -text
requirements.txt -text
requirements-quality.in text eol=lf
requirements-quality.lock text eol=lf
pyproject.toml -text
run_*.py -text
scripts/*.py -text
scripts/*.ps1 -text
src/*.py -text
tests/*.py text eol=lf
audits/statistical/statistical_diagnostics.json text eol=lf
audits/statistical/statistical_diagnostics.md text eol=lf
forward_experiment/**/*.json -text
forward_experiment/**/*.sha256 -text
forward_experiment/**/*.sql -text
experiments/runs/**/*.json text eol=crlf
experiments/runs/**/*.md text eol=crlf
experiments/runs/**/*.jsonl -text
experiments/runs/**/*.parquet -text
